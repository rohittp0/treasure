    "posthog-js": "^1.444.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
