rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('[a-z][a-z0-9_]{2,19}')
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      allow update, delete: if false;
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && username.matches('[a-z][a-z0-9_]{2,19}')
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 48
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /puzzles/{puzzleId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Daily quest lists, one document per month. Published with scripts/seed-firestore.mjs.
    match /dailyQuests/{month} {
      allow read: if true;
      allow write: if false;
    }

    match /friendHunts/{code} {
      function fields() {
        return ['hiderUid', 'hiderName', 'targetUid', 'targetUsername', 'seekerUid', 'seekerName', 'clues',
          'status', 'createdAt', 'startedAt', 'endedAt', 'cluesVisible',
          'costSeconds', 'wrongGuesses', 'triedIds', 'lastGuessId',
          'lastGuessOutcome', 'revealed'];
      }
      function changedOnly(allowed) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
      }
      function participant() {
        return request.auth != null &&
          (request.auth.uid == resource.data.hiderUid || request.auth.uid == resource.data.seekerUid);
      }
      function roundSeconds() {
        return 'roundSeconds' in resource.data ? resource.data.roundSeconds : 120;
      }
      function activeSeeker() {
        return request.auth != null && request.auth.uid == resource.data.seekerUid
          && resource.data.status == 'playing'
          && resource.data.startedAt is timestamp
          && request.time < resource.data.startedAt + duration.value(roundSeconds() - resource.data.costSeconds, 's');
      }
      function answerId() {
        return get(/databases/$(database)/documents/friendHunts/$(code)/private/answer).data.id;
      }
      function validCreate() {
        return request.auth != null
          && code.matches('[A-HJ-NP-Z2-9]{10}')
          && request.resource.data.keys().hasOnly(fields().concat(['hiderUsername', 'roundSeconds']))
          && request.resource.data.keys().hasAll(fields())
          && (!('roundSeconds' in request.resource.data) || request.resource.data.roundSeconds == 180)
          && request.resource.data.hiderUid == request.auth.uid
          && request.resource.data.hiderName is string
          && request.resource.data.hiderName.size() <= 48
          && (!('hiderUsername' in request.resource.data) ||
            (request.resource.data.hiderUsername is string
              && request.resource.data.hiderUsername.matches('[a-z][a-z0-9_]{2,19}')
              && request.resource.data.hiderUsername == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username))
          && ((request.resource.data.targetUid == null && request.resource.data.targetUsername == null)
            || (request.resource.data.targetUid is string
              && request.resource.data.targetUid != request.auth.uid
              && request.resource.data.targetUsername is string
              && request.resource.data.targetUsername.matches('[a-z][a-z0-9_]{2,19}')
              && get(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername)).data.uid == request.resource.data.targetUid
              && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetUid)/notifications/$(code)).data.code == code))
          && request.resource.data.seekerUid == null
          && request.resource.data.seekerName == null
          && request.resource.data.clues is list
          && request.resource.data.clues.size() == 3
          && request.resource.data.clues[0] is string
          && request.resource.data.clues[1] is string
          && request.resource.data.clues[2] is string
          && request.resource.data.clues[0].size() >= 5
          && request.resource.data.clues[1].size() >= 5
          && request.resource.data.clues[2].size() >= 5
          && request.resource.data.clues[0].size() <= 180
          && request.resource.data.clues[1].size() <= 180
          && request.resource.data.clues[2].size() <= 180
          && request.resource.data.status == 'waiting'
          && request.resource.data.createdAt == request.time
          && request.resource.data.startedAt == null
          && request.resource.data.endedAt == null
          && request.resource.data.cluesVisible == 1
          && request.resource.data.costSeconds == 0
          && request.resource.data.wrongGuesses == 0
          && request.resource.data.triedIds == []
          && request.resource.data.lastGuessId == ''
          && request.resource.data.lastGuessOutcome == ''
          && request.resource.data.revealed == false;
      }
      function validJoin() {
        return request.auth != null
          && resource.data.status == 'waiting'
          && request.auth.uid != resource.data.hiderUid
          && (resource.data.targetUid == null || resource.data.targetUid == request.auth.uid)
          && changedOnly(['seekerUid', 'seekerName', 'status', 'startedAt'])
          && request.resource.data.seekerUid == request.auth.uid
          && request.resource.data.seekerName is string
          && request.resource.data.seekerName.size() <= 48
          && request.resource.data.status == 'playing'
          && request.resource.data.startedAt == request.time;
      }
      function validUnlock() {
        return activeSeeker()
          && resource.data.cluesVisible < 3
          && request.time < resource.data.startedAt + duration.value(roundSeconds() - 20 - resource.data.costSeconds, 's')
          && changedOnly(['cluesVisible', 'costSeconds'])
          && request.resource.data.cluesVisible == resource.data.cluesVisible + 1
          && request.resource.data.costSeconds == resource.data.costSeconds + 20;
      }
      function validReveal() {
        return activeSeeker()
          && resource.data.cluesVisible == 3
          && resource.data.revealed == false
          && request.time < resource.data.startedAt + duration.value(roundSeconds() - 30 - resource.data.costSeconds, 's')
          && changedOnly(['revealed', 'costSeconds'])
          && request.resource.data.revealed == true
          && request.resource.data.costSeconds == resource.data.costSeconds + 30;
      }
      function freshGuess() {
        return request.resource.data.lastGuessId is string
          && request.resource.data.lastGuessId.matches('[A-Z]{3}')
          && !(request.resource.data.lastGuessId in resource.data.triedIds);
      }
      function validCorrectGuess() {
        return activeSeeker()
          && changedOnly(['status', 'endedAt', 'lastGuessId', 'lastGuessOutcome'])
          && freshGuess()
          && request.resource.data.lastGuessId == answerId()
          && request.resource.data.lastGuessOutcome == 'correct'
          && request.resource.data.status == 'won'
          && request.resource.data.endedAt == request.time;
      }
      function validWrongGuess() {
        return activeSeeker()
          && changedOnly(['costSeconds', 'wrongGuesses', 'triedIds', 'lastGuessId', 'lastGuessOutcome'])
          && freshGuess()
          && request.resource.data.lastGuessId != answerId()
          && request.resource.data.lastGuessOutcome == 'wrong'
          && request.resource.data.costSeconds == resource.data.costSeconds + 5
          && request.resource.data.wrongGuesses == resource.data.wrongGuesses + 1
          && request.resource.data.triedIds == resource.data.triedIds.concat([request.resource.data.lastGuessId]);
      }
      function validTimeout() {
        return participant()
          && resource.data.status == 'playing'
          && request.time >= resource.data.startedAt + duration.value(roundSeconds() - resource.data.costSeconds, 's')
          && changedOnly(['status', 'endedAt'])
          && request.resource.data.status == 'lost'
          && request.resource.data.endedAt == request.time;
      }

      allow get: if request.auth != null &&
        (participant() || resource.data.status in ['won', 'lost'] || (resource.data.status == 'waiting' &&
          (resource.data.targetUid == null || resource.data.targetUid == request.auth.uid)));
      allow list: if participant();
      allow create: if validCreate();
      allow update: if validJoin() || validUnlock() || validReveal()
        || validCorrectGuess() || validWrongGuess() || validTimeout();
      allow delete: if false;

      match /private/{privateId} {
        function hunt() {
          return get(/databases/$(database)/documents/friendHunts/$(code)).data;
        }
        allow get: if request.auth != null && privateId == 'answer' &&
          (request.auth.uid == hunt().hiderUid ||
            (request.auth.uid == hunt().seekerUid &&
              (hunt().revealed == true || hunt().status in ['won', 'lost'])));
        allow list: if false;
        allow create: if request.auth != null && privateId == 'answer'
          && getAfter(/databases/$(database)/documents/friendHunts/$(code)).data.hiderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/friendHunts/$(code)).data.status == 'waiting'
          && request.resource.data.keys().hasOnly(['id', 'country', 'lng', 'lat'])
          && request.resource.data.keys().hasAll(['id', 'country', 'lng', 'lat'])
          && request.resource.data.id is string
          && request.resource.data.id.matches('[A-Z]{3}')
          && request.resource.data.country is string
          && request.resource.data.country.size() <= 80
          && request.resource.data.lng is number
          && request.resource.data.lat is number
          && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{userId} {
      // Entries from clients released before the daily quest have no dailyFinds field.
      function previousDailyFinds() {
        return 'dailyFinds' in resource.data ? resource.data.dailyFinds : 0;
      }
      function nextDailyFinds() {
        return 'dailyFinds' in request.resource.data ? request.resource.data.dailyFinds : 0;
      }
      function validEntry() {
        return request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'name', 'averageTenths', 'levelsCompleted', 'highestLevel', 'dailyFinds', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'averageTenths', 'levelsCompleted', 'highestLevel', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 32
          && request.resource.data.name == get(/databases/$(database)/documents/profiles/$(userId)).data.username
          && request.resource.data.averageTenths is int
          && request.resource.data.averageTenths >= 0
          && request.resource.data.averageTenths <= 1800
          && request.resource.data.levelsCompleted is int
          && request.resource.data.levelsCompleted >= 0
          && nextDailyFinds() is int
          && nextDailyFinds() >= 0
          && request.resource.data.levelsCompleted + nextDailyFinds() > 0
          && request.resource.data.highestLevel is int
          && request.resource.data.highestLevel >= request.resource.data.levelsCompleted
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validEntry();
      // A new level or daily find may raise the average; otherwise it may only improve.
      allow update: if validEntry() &&
        (!resource.data.keys().hasAll(['averageTenths', 'levelsCompleted', 'highestLevel']) ||
          (request.resource.data.levelsCompleted >= resource.data.levelsCompleted &&
            request.resource.data.highestLevel >= resource.data.highestLevel &&
            nextDailyFinds() >= previousDailyFinds() &&
            (request.resource.data.levelsCompleted > resource.data.levelsCompleted ||
              nextDailyFinds() > previousDailyFinds() ||
              request.resource.data.averageTenths <= resource.data.averageTenths)));
      allow delete: if false;
    }

    // Monthly daily-quest board: most finds first, then the least total time used.
    match /monthlyLeaderboard/{month}/entries/{userId} {
      function validMonthly() {
        let data = request.resource.data;
        return request.auth != null
          && request.auth.uid == userId
          && month.matches('[0-9]{4}-[0-9]{2}')
          && data.keys().hasOnly(['uid', 'name', 'month', 'found', 'played', 'timeUsed', 'rankScore', 'updatedAt'])
          && data.keys().hasAll(['uid', 'name', 'month', 'found', 'played', 'timeUsed', 'rankScore', 'updatedAt'])
          && data.uid == userId
          && data.month == month
          && data.name is string
          && data.name == get(/databases/$(database)/documents/profiles/$(userId)).data.username
          && data.found is int && data.played is int && data.timeUsed is int && data.rankScore is int
          && data.found >= 0 && data.found <= data.played && data.played <= 31
          && data.timeUsed >= 0 && data.timeUsed <= data.found * 180
          && data.rankScore == data.found * 10000 - data.timeUsed
          && data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validMonthly();
      allow update: if validMonthly()
        && request.resource.data.found >= resource.data.found
        && request.resource.data.played >= resource.data.played;
      allow delete: if false;
    }

    // Public explorer maps of countries collected from daily quests, keyed by username.
    match /atlases/{username} {
      function validAtlas() {
        let data = request.resource.data;
        return request.auth != null
          && data.keys().hasOnly(['uid', 'name', 'countries', 'count', 'updatedAt'])
          && data.keys().hasAll(['uid', 'name', 'countries', 'count', 'updatedAt'])
          && data.uid == request.auth.uid
          && data.name == username
          && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username
          && data.countries is map
          && data.countries.size() <= 400
          && data.count == data.countries.size()
          && data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validAtlas();
      allow update: if validAtlas() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /hunts/{huntId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // One daily-quest attempt per UTC day: created when it starts, finished exactly once.
      match /daily/{day} {
        function owner() {
          return request.auth != null && request.auth.uid == userId;
        }
        function resultFields(data) {
          return data.timeUsed is int && data.timeUsed >= 0 && data.timeUsed <= 180
            && data.cluesUsed is int && data.cluesUsed >= 1 && data.cluesUsed <= 3
            && data.wrongGuesses is int && data.wrongGuesses >= 0
            && data.revealedCountry is bool;
        }
        allow read: if owner();
        allow create: if owner()
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['day', 'puzzleId', 'country', 'status', 'timeUsed', 'cluesUsed', 'wrongGuesses', 'revealedCountry', 'startedAt', 'endedAt'])
          && request.resource.data.keys().hasAll(['day', 'puzzleId', 'country', 'status', 'timeUsed', 'cluesUsed', 'wrongGuesses', 'revealedCountry', 'startedAt', 'endedAt'])
          && request.resource.data.day == day
          && request.resource.data.puzzleId is string
          && request.resource.data.puzzleId.matches('[A-Z]{3}')
          && request.resource.data.country is string
          && request.resource.data.country.size() <= 80
          && request.resource.data.status in ['playing', 'won', 'lost']
          && resultFields(request.resource.data)
          && request.resource.data.startedAt == request.time
          && (request.resource.data.status == 'playing'
            ? request.resource.data.endedAt == null
            : request.resource.data.endedAt == request.time);
        allow update: if owner()
          && resource.data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeUsed', 'cluesUsed', 'wrongGuesses', 'revealedCountry', 'endedAt'])
          && request.resource.data.status in ['won', 'lost']
          && resultFields(request.resource.data)
          && request.resource.data.endedAt == request.time
          // A hunt's time used includes its wall-clock time, so a late win cannot claim a fast time.
          && (request.resource.data.status == 'lost'
            || request.time <= resource.data.startedAt + duration.value(request.resource.data.timeUsed + 600, 's'));
        allow delete: if false;
      }

      match /notifications/{code} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && code.matches('[A-HJ-NP-Z2-9]{10}')
          && request.resource.data.keys().hasOnly(['code', 'fromUid', 'fromUsername', 'createdAt', 'read'])
          && request.resource.data.keys().hasAll(['code', 'fromUid', 'fromUsername', 'createdAt', 'read'])
          && request.resource.data.code == code
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUsername is string
          && request.resource.data.fromUsername == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && !exists(/databases/$(database)/documents/friendHunts/$(code))
          && getAfter(/databases/$(database)/documents/friendHunts/$(code)).data.hiderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/friendHunts/$(code)).data.targetUid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }

      match /pushTokens/{tokenHash} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && tokenHash.matches('[a-f0-9]{64}')
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.keys().hasAll(['token', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() < 500
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
